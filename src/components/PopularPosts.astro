---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getSortedPostsList, type PostForList } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
import WidgetLayout from "./widget/WidgetLayout.astro";

const posts = await getSortedPostsList();
const topPosts = posts.slice(0, 3);

if (topPosts.length === 0) return null;
const COLLAPSED_HEIGHT = "12rem";
const isCollapsed = topPosts.length > 3;
---
<WidgetLayout name={i18n(I18nKey.popularPosts)} id="popular-posts" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}>
    <div class="flex flex-col gap-1">
        {topPosts.map((post, idx) => (
            <a href={getPostUrlBySlug(post.slug)}
               class="rounded-xl px-3 py-2.5 flex items-center gap-3 transition text-sm hover:bg-[var(--btn-plain-bg-hover)] group">
                <span class="w-6 h-6 rounded-lg bg-[var(--primary)]/10 text-[var(--primary)] flex items-center justify-center text-xs font-bold shrink-0">
                    {idx + 1}
                </span>
                <span class="flex-1 truncate text-75 group-hover:text-[var(--primary)] transition">
                    {post.data.title}
                </span>
            </a>
        ))}
    </div>
</WidgetLayout>
