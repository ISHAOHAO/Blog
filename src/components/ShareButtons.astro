---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

interface Props {
  title: string;
  url: string;
  class?: string;
}

const { title, url } = Astro.props;
const className = Astro.props.class;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const copiedText = i18n(I18nKey.shareCopied);
const copyLinkText = i18n(I18nKey.shareCopyLink);
const wechatScanHint = i18n(I18nKey.shareWechatScanHint);
const xiaohongshuHint = i18n(I18nKey.shareXiaohongshuHint);
const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodedUrl}`;
---

<div class:list={["share-buttons", className]}>
  <div class="flex items-center gap-2 text-sm text-50 mb-2">
    <Icon name="material-symbols:share-outline" class="text-base" />
    <span>{i18n(I18nKey.shareText)}</span>
  </div>
  <div class="flex flex-wrap gap-2">
    <button
      id="share-wechat-btn"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="fa6-brands:weixin" class="text-sm" />
      <span>{i18n(I18nKey.shareViaWechat)}</span>
    </button>
    <a
      href={`https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="fa6-brands:weibo" class="text-sm" />
      <span>{i18n(I18nKey.shareViaWeibo)}</span>
    </a>
    <button
      id="share-qq-btn"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="fa6-brands:qq" class="text-sm" />
      <span>{i18n(I18nKey.shareViaQQ)}</span>
    </button>
    <button
      id="share-xhs-btn"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="material-symbols:edit-square-outline" class="text-sm" />
      <span id="share-xhs-label">{i18n(I18nKey.shareViaXiaohongshu)}</span>
    </button>
    <a
      href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="fa6-brands:twitter" class="text-sm" />
      <span>{i18n(I18nKey.shareViaTwitter)}</span>
    </a>
    <button
      id="share-copy-btn"
      class="btn-regular rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-1.5"
    >
      <Icon name="material-symbols:link" class="text-sm" />
      <span id="share-copy-label">{copyLinkText}</span>
    </button>
  </div>
</div>

<div
  id="wechat-qr-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-black/50 hidden"
>
  <div
    class="bg-white dark:bg-[oklch(0.23_0.015_var(--hue))] rounded-2xl p-6 mx-4 max-w-sm w-full text-center shadow-2xl"
  >
    <div class="text-lg font-bold text-90 mb-1">
      {i18n(I18nKey.shareViaWechat)}
    </div>
    <div class="text-sm text-50 mb-4">{wechatScanHint}</div>
    <img
      id="wechat-qr-img"
      src={qrApiUrl}
      alt="WeChat QR Code"
      class="w-[200px] h-[200px] mx-auto rounded-xl"
    />
    <button
      id="wechat-qr-close"
      class="btn-regular rounded-lg w-full mt-4 py-2 text-sm font-medium"
    >
      关闭
    </button>
  </div>
</div>

<style>
  #wechat-qr-modal {
    animation: fadeIn 0.2s ease-out;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script define:vars={{ url, title, copiedText, copyLinkText, xiaohongshuHint }}>
  const copyBtn = document.getElementById("share-copy-btn");
  const copyLabel = document.getElementById("share-copy-label");
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(url).then(() => {
        copyLabel.textContent = copiedText;
        setTimeout(() => {
          copyLabel.textContent = copyLinkText;
        }, 2000);
      });
    });
  }

  const xhsBtn = document.getElementById("share-xhs-btn");
  const xhsLabel = document.getElementById("share-xhs-label");
  if (xhsBtn && xhsLabel) {
    const original = xhsLabel.textContent || "";
    xhsBtn.addEventListener("click", async () => {
      if (isMobile()) {
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (_) {}
        }

        const launched = { value: false };
        const onHide = () => { launched.value = true; };
        window.addEventListener("pagehide", onHide, { once: true });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) launched.value = true;
        }, { once: true });

        window.location.href = "xhsdiscover://";
        navigator.clipboard.writeText(url).then(() => {
          if (!launched.value) {
            xhsLabel.textContent = xiaohongshuHint;
            setTimeout(() => {
              xhsLabel.textContent = original;
            }, 2000);
          }
        });

        setTimeout(() => {
          window.removeEventListener("pagehide", onHide);
          if (!launched.value) {
            xhsLabel.textContent = xiaohongshuHint;
            setTimeout(() => {
              xhsLabel.textContent = original;
            }, 2000);
          }
        }, 2500);
      } else {
        navigator.clipboard.writeText(url).then(() => {
          xhsLabel.textContent = xiaohongshuHint;
          setTimeout(() => {
            xhsLabel.textContent = original;
          }, 2000);
        });
      }
    });
  }

  function isMobile() {
    return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  }

  const qqBtn = document.getElementById("share-qq-btn");
  if (qqBtn) {
    qqBtn.addEventListener("click", () => {
      if (isMobile()) {
        const qqUrl = `mqqapi://share/to_fri?src_type=web&version=1&file_type=news&url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
        let launched = false;
        const onHide = () => { launched = true; };
        window.addEventListener("pagehide", onHide, { once: true });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) launched = true;
        }, { once: true });

        window.location.href = qqUrl;

        setTimeout(() => {
          window.removeEventListener("pagehide", onHide);
          if (!launched) {
            window.open(
              `https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`,
              "_blank",
            );
          }
        }, 2000);
      } else {
        window.open(
          `https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`,
          "_blank",
        );
      }
    });
  }

  const wechatBtn = document.getElementById("share-wechat-btn");
  const wechatModal = document.getElementById("wechat-qr-modal");
  const wechatClose = document.getElementById("wechat-qr-close");
  if (wechatBtn && wechatModal) {
    wechatBtn.addEventListener("click", async () => {
      if (isMobile()) {
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (_) {}
        }

        const launched = { value: false };
        const onHide = () => { launched.value = true; };
        window.addEventListener("pagehide", onHide, { once: true });
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) launched.value = true;
        }, { once: true });

        window.location.href = "weixin://";
        navigator.clipboard.writeText(url).catch(() => {});

        setTimeout(() => {
          window.removeEventListener("pagehide", onHide);
          if (!launched.value) {
            wechatModal.classList.remove("hidden");
          }
        }, 2500);
      } else {
        wechatModal.classList.remove("hidden");
      }
    });
    wechatModal.addEventListener("click", (e) => {
      if (e.target === wechatModal) wechatModal.classList.add("hidden");
    });
    if (wechatClose) {
      wechatClose.addEventListener("click", () =>
        wechatModal.classList.add("hidden"),
      );
    }
  }
</script>
