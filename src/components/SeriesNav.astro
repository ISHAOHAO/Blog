---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import type { SeriesInfo } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
    series: SeriesInfo;
    currentSlug: string;
    class?: string;
}

const { series, currentSlug } = Astro.props;
const className = Astro.props.class;
const currentIndex = series.posts.findIndex((post) => post.slug === currentSlug);
const progress = currentIndex >= 0 ? ((currentIndex + 1) / series.posts.length) * 100 : 0;

if (!series || series.posts.length <= 1) return null;
---
<div class:list={[className]}>
    <div class="flex items-center justify-between gap-3 text-sm text-50 mb-2">
        <div class="flex items-center gap-2 min-w-0">
        <Icon name="material-symbols:collections-bookmark-outline" class="text-base" />
        <span class="truncate">{i18n(I18nKey.seriesPosts)}: {series.name}</span>
        </div>
        <span class="shrink-0">{currentIndex + 1}/{series.posts.length}</span>
    </div>
    <div class="h-1.5 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden mb-3" aria-label={`系列进度 ${Math.round(progress)}%`}>
        <div class="h-full bg-[var(--primary)] transition-all" style={`width: ${progress}%`}></div>
    </div>
    <div class="flex flex-col gap-1">
        {series.posts.map((post, idx) => (
            <a href={getPostUrlBySlug(post.slug)}
               class:list={[
                   "rounded-xl px-4 py-2.5 flex items-center gap-3 transition text-sm",
                   post.slug === currentSlug
                       ? "bg-[var(--primary)]/10 text-[var(--primary)] font-medium"
                       : "text-75 hover:bg-[var(--btn-plain-bg-hover)] hover:text-90"
               ]}>
                <span class="w-6 h-6 rounded-lg bg-[var(--btn-regular-bg)] flex items-center justify-center text-xs font-bold shrink-0">
                    {post.order || idx + 1}
                </span>
                <span class="truncate">{post.title}</span>
                {post.slug === currentSlug && (
                    <Icon name="material-symbols:arrow-left-rounded" class="text-sm ml-auto shrink-0" />
                )}
            </a>
        ))}
    </div>
</div>
