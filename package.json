{
	"name": "Blog",
	"type": "module",
	"version": "v1.8.0",
	"engines": {
		"node": ">=22.23.4",
		"pnpm": ">=10.29.3"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "node scripts/validate-content.js && astro check",
		"build": "node scripts/validate-content.js && astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit --isolatedDeclarations",
		"new-post": "node scripts/new-post.js",
		"validate-content": "node scripts/validate-content.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.1.1",
		"@expressive-code/core": "^0.44.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.3",
		"@expressive-code/plugin-line-numbers": "^0.44.3",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify/svelte": "^5.2.3",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@vercel/speed-insights": "^1.3.1",
		"astro": "7.4.2",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"github-slugger": "^2.0.0",
		"hastscript": "^9.0.1",
		"katex": "^0.18.10",
		"markdown-it": "^14.3.3",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.17.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"stylus": "^0.64.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.6.2",
		"@iconify-json/ant-design": "^1.2.9",
		"@iconify-json/material-symbols": "^1.2.95",
		"@rollup/plugin-yaml": "^5.0.1",
